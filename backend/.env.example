# Copy this file, rename the copy to .env, and fill in real values.
# Never upload .env to GitHub.

FRONTEND_URL=http://localhost:3000

# Supabase → Connect → Direct → Session pooler (put your password in)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# A long random secret used to sign login tokens. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste-a-long-random-secret-here

# Groq AI key from https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here
